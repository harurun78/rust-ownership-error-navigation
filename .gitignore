# Dependencies
node_modules/

# Build and coverage output
dist/
build/
coverage/
*.tsbuildinfo

# Local validation upstream checkouts
validation/ports/*/upstream/*/
!validation/ports/*/upstream/.gitkeep
!validation/ports/*/upstream/*.md
validation/ports/*/rust-port/target/
validation/ports/*/tracks/*/rust-port/target/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local overrides
.env
.env.*
!.env.example

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Package manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
